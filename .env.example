# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=6507

# --- Letta App Server (single source of truth for memory) ---
LETTA_APP_SERVER_URL=http://127.0.0.1:4500
# Generate with: openssl rand -hex 32 (must match the App Server's token)
LETTA_APP_SERVER_TOKEN=replace-with-a-random-token
REQUEST_TIMEOUT_MS=60000
STREAM_MAX_CHARS=4000

# --- Agents ---
# Global default agent. Every tool also accepts agent_id, which wins.
DEFAULT_LETTA_AGENT_ID=
# Project -> agent mapping file (optional). Explicit agent_id still wins.
AGENTS_FILE=./agents.json
# Working directory the App Server session uses inside its container.
SESSION_CWD=/workspace

# --- Agent creation defaults (used only when the caller omits them) ---
DEFAULT_PERSONA=You are a helpful coding assistant with long-term memory.
DEFAULT_HUMAN=
DEFAULT_MODEL=

# --- Memory tool defaults ---
DEFAULT_TOP_K=5
DEFAULT_LIST_LIMIT=20

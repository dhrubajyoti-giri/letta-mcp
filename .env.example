# --- App Server (letta-code image) ---
# Host port mapped to the server's container port 4500.
APP_SERVER_PORT=4500
# Pin the image; must stay compatible with @letta-ai/letta-agent-sdk in package.json.
LETTA_CODE_VERSION=0.32.7
# local = agent state stays in the letta-state volume. Use cloud only with LETTA_API_KEY.
LETTA_BACKEND=local
# Shared secret: the MCP server authenticates to the App Server with this.
# Generate with: openssl rand -hex 32
LETTA_APP_SERVER_TOKEN=replace-with-a-random-token
# Model provider for inference. Pick ONE path:
# FREE path: run Ollama on the host (ollama pull qwen3), leave the keys below
# commented out, and connect it once with:
#   docker exec -it <app-server-container> letta connect ollama
# pointing it at http://host.docker.internal:11434 (reachable via extra_hosts).
# PAID path: set one of these instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Required only when LETTA_BACKEND=cloud.
# LETTA_API_KEY=

# --- MCP server ---
MCP_HOST=0.0.0.0
MCP_PORT=6507
# Bearer token guarding /mcp (server refuses to start without it).
# Generate with: openssl rand -hex 32 (use a DIFFERENT value than above)
MCP_AUTH_TOKEN=replace-with-another-random-token
# NOTE: LETTA_APP_SERVER_URL is set in docker-compose.yml to the compose
# service address (http://app-server:4500). Only set it here when running
# the MCP outside compose, e.g. LETTA_APP_SERVER_URL=http://127.0.0.1:4500
# LETTA_APP_SERVER_URL=http://127.0.0.1:4500
REQUEST_TIMEOUT_MS=60000
STREAM_MAX_CHARS=4000

# --- Agents ---
# Every tool takes a required agent_id. Which project uses which agent is
# decided per request by the caller.
# Working directory the App Server session uses inside its container.
SESSION_CWD=/workspace

# --- Agent creation defaults (used only when the caller omits them) ---
# All empty by design: the server applies its own defaults when omitted.
# Set values here only to define workspace-wide fallbacks.
DEFAULT_PERSONA=
DEFAULT_HUMAN=
DEFAULT_MODEL=
# Embedding handle for new agents (provider-qualified, e.g. openai/<model>,
# google_ai/<model>, ollama/<model>). No catalog endpoint exists for embeddings;
# use the provider's model name. Leave empty to use the server default.
# For a free local option, run Ollama (see docker-compose.yml local-embeddings
# profile) and set e.g. ollama/qwen3-embedding:0.6b (32K context, code-aware).
DEFAULT_EMBEDDING=
# Only needed when the App Server should reach Ollama over the compose network
# (e.g. for Ollama-backed models/embeddings). Unset by default.
# OLLAMA_BASE_URL=http://ollama:11434/v1

# --- Memory tool defaults ---
DEFAULT_TOP_K=5
DEFAULT_LIST_LIMIT=20
